# ============================================================================
# Docker Executor Configuration
# ============================================================================
# Copy this file to .env and adjust values for your environment

# ==========================
# Docker Settings
# ==========================
# Enable Docker-based execution (HIGHLY RECOMMENDED for production)
DOCKER_ENABLED=true

# Docker host connection
# Unix/Linux/Mac: unix:///var/run/docker.sock
# Windows: npipe:////./pipe/docker_engine
# Remote: tcp://hostname:2375
DOCKER_HOST=unix:///var/run/docker.sock

# ==========================
# Fallback Behavior
# ==========================
# Allow fallback to local execution if Docker fails (NOT RECOMMENDED for production)
FALLBACK_TO_LOCAL=true

# Require Docker (fail if Docker is not available)
# Set to true in production to ensure security
REQUIRE_DOCKER=false

# ==========================
# Execution Limits
# ==========================
# Maximum execution time in seconds (1-300)
DEFAULT_TIMEOUT=10

# Memory limit per container (e.g., 128m, 256m, 512m, 1g)
DEFAULT_MEMORY_LIMIT=256m

# CPU quota (percentage of one core * 1000)
# 50000 = 50% of one core, 100000 = 100% of one core
DEFAULT_CPU_QUOTA=50000

# ==========================
# Container Management
# ==========================
# Maximum number of concurrent containers
MAX_CONCURRENT_CONTAINERS=10

# Delay before cleaning up stopped containers (seconds)
CONTAINER_CLEANUP_DELAY=5

# Automatically remove containers after execution
CONTAINER_AUTO_REMOVE=true

# ==========================
# Security Settings
# ==========================
# Disable network access in containers (RECOMMENDED)
NETWORK_DISABLED=true

# Make root filesystem read-only (RECOMMENDED)
READ_ONLY_ROOTFS=true

# Maximum output size in bytes (prevents DoS via infinite output)
MAX_OUTPUT_SIZE=10240

# ==========================
# Docker Images
# ==========================
# Python execution image
PYTHON_DOCKER_IMAGE=grader-python-sandbox:latest

# JavaScript execution image (future support)
JS_DOCKER_IMAGE=grader-js-sandbox:latest

# Java execution image (future support)
JAVA_DOCKER_IMAGE=grader-java-sandbox:latest

# ==========================
# Language Settings
# ==========================
# Python version to use
PYTHON_VERSION=3.11

# ==========================
# Logging
# ==========================
# Log detailed execution information
LOG_EXECUTION_DETAILS=true

# Log student code (CAUTION: privacy implications)
LOG_STUDENT_CODE=false

# ==========================
# Performance
# ==========================
# Number of worker threads for execution pool
EXECUTION_POOL_SIZE=5

# Enable result caching (experimental)
ENABLE_CACHING=false

# ==========================
# Production Recommendations
# ==========================
# For production environments, use these settings:
# DOCKER_ENABLED=true
# FALLBACK_TO_LOCAL=false
# REQUIRE_DOCKER=true
# NETWORK_DISABLED=true
# READ_ONLY_ROOTFS=true
# LOG_STUDENT_CODE=false
